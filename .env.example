APP_NAME=RantPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laragon MySQL. Create an empty database named rantpilot first (root, no password).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rantpilot
DB_USERNAME=root
DB_PASSWORD=

# Tests ignore this file and use sqlite in memory (see phpunit.xml).

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq writes the clips and headlines. Leave the key empty to use the built-in offline generator.
# Never put a real key in git. This file is only a placeholder.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Avatar Studio. Photo mode needs ffmpeg only. Leave the token empty to keep lip-sync off.
# Chatterbox is the local voice clone. Kokoro is the fallback and does not clone your voice.
AVATAR_VOICE_ENGINE=auto
AVATAR_PYTHON=
AVATAR_FFMPEG=ffmpeg
AVATAR_FFPROBE=ffprobe
AVATAR_CHATTERBOX_DEVICE=cpu
# Importing Chatterbox can take about 30 seconds on this CPU. The check waits this many seconds.
# A successful check is remembered for a day, or until the voice venv changes. Auto will not switch to Kokoro.
AVATAR_ENGINE_CHECK_TIMEOUT=120
# Approved Chatterbox settings. Voiceover sliders and Avatar Studio start here.
AVATAR_EXAGGERATION=0.4
AVATAR_CFG=0.35
REPLICATE_API_TOKEN=
REPLICATE_LIPSYNC_MODEL=cjwbw/sadtalker
